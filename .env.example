# ---- Database (required) ----------------------------------------------------
# Postgres connection string (Neon / Supabase / Vercel Postgres / local).
# `npm run build` runs `drizzle-kit push` against it before `next build`,
# so the schema is always in sync with the deployed code.
DATABASE_URL=postgres://user:password@host:5432/quill?sslmode=require

# ---- Firebase (optional override) -------------------------------------------
# The public web config lives in src/lib/firebase-config.ts. Set this only if
# you point the app at a different Firebase project; the browser SDK and the
# server-side token verifier both read it, so they can never disagree.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=parallel-979e8

# ---- Mimo (optional) --------------------------------------------------------
# Without a key the AI coach endpoint answers 503 and everything else works.
OPENAI_API_KEY=
